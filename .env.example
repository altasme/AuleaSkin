# Copy to .env.local and fill in once the client's ad account / analytics
# access is available (see docs/intake-checklist.md, "Technical access").
# Nothing in src/lib/analytics.tsx fires until these are set.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API access token, SERVER SIDE ONLY, never expose
# with a NEXT_PUBLIC_ prefix. Required for CAPI per spec §8.
META_CAPI_ACCESS_TOKEN=

# Canonical site URL, used for metadata/sitemap generation.
NEXT_PUBLIC_SITE_URL=https://example.com
