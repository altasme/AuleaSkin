# Copy to .env.local and fill in once the client's ad account / analytics
# access is available (see docs/intake-checklist.md, "Technical access").
# Nothing in src/lib/analytics.tsx fires until these are set.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API access token, SERVER SIDE ONLY, never expose
# with a NEXT_PUBLIC_ prefix. Required for CAPI per spec §8.
META_CAPI_ACCESS_TOKEN=

# Canonical site URL, used for metadata/sitemap generation.
NEXT_PUBLIC_SITE_URL=https://example.com

# Cloudinary, used by the admin panel's image uploader (src/app/adminpanel,
# see docs/admin-panel.md). This site has no server, so uploads go straight
# from the browser to Cloudinary as an UNSIGNED upload: only the cloud name
# and a preset name are needed, never the API key or API secret. Create the
# preset in the Cloudinary console under Settings > Upload > Upload presets
# > Add upload preset, set its Signing Mode to "Unsigned", then paste its
# name below.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=o300ubug
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=auleaskin
